# Copy to .env (git-ignored). Names only for secrets — never commit values.
# API_URL / NEXT_PUBLIC_API_URL are the backend ORIGIN only (no /api/v1).

# --- backend ---
DATABASE_URL=sqlite:///./rivermind.db
USE_MOCK_AI=true
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
COUNCIL_API_KEY=
COUNCIL_EMAIL=
COUNCIL_PASSWORD=
CORS_ORIGINS=http://localhost:3000
DEVICE_ID=yamuna-okhla-01
DEVICE_TOKEN=
CAMERA_LAT=
CAMERA_LON=
MIN_BOUNTY_CENTS=500
MAX_BOUNTY_CENTS=5000
DAILY_CAP_CENTS=20000
SEED_TREASURY_CENTS=50000
COUNCIL_THRESHOLD_CENTS=2000
MAX_INVOICE_CENTS=50000

# --- ai ---
# LLM_PROVIDER: groq | anthropic | gemini
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ROBOFLOW_API_KEY: laptop dataset-download tools only; the app never uses it
ROBOFLOW_API_KEY=
# GROQ_API_KEY_EVAL: optional second Groq key used only by eval/ scripts, so evals never use up the daily token
# quota (free tier: 200,000 tokens/day) that the website and demo need. Make it on a DIFFERENT Groq account:
# limits are per account, so two keys on one account share one quota
GROQ_API_KEY_EVAL=
# AI_DETECTOR: onnx (our trained YOLO11n detector, default) | llm (vision-LLM counts, no boxes; for small servers)
AI_DETECTOR=onnx
DETECTOR_MODEL_PATH=

# --- scripts ---
API_URL=http://localhost:8000
PAYPAL_SANDBOX_RECEIVER=

# --- frontend (put these in frontend/.env.local; Next.js only reads env files inside frontend/) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_USE_MOCK=true
