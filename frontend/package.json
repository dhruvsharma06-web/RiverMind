{
  "name": "rivermind-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node scripts/copy-fixtures.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/copy-fixtures.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "format:check": "prettier --check .",
    "gen:types": "openapi-typescript openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.0.0",
    "@fontsource/marcellus": "^5.0.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "4.0.18"
  }
}
